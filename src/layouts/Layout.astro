---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogDescription?: string;
  route: 'home' | 'about' | 'our-range' | 'faq' | 'contact' | 'order';
}

const { title, description, ogDescription = description, route } = Astro.props;
const current = (r: Props['route']) => (r === route ? 'page' : undefined);
---
<!doctype html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="theme-color" content="#000000">
<meta property="og:type" content="website">
<meta property="og:locale" content="en_AU">
<meta property="og:site_name" content="Pasticceria Dolce Vita">
<meta property="og:title" content={title}>
<meta property="og:description" content={ogDescription}>
<!-- When the domain is live, add: <link rel="canonical" href="https://YOUR-DOMAIN/"> and an og:image -->

<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Source+Sans+3:wght@400;500;600&display=swap" rel="stylesheet">

<script type="application/ld+json" is:inline>
{
  "@context": "https://schema.org",
  "@type": "Bakery",
  "name": "Pasticceria Dolce Vita",
  "description": "Italian cake shop specialising in continental and gelato cakes. Cakes to order for all occasions.",
  "telephone": "+61478774466",
  "servesCuisine": "Italian",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Carnes Hill Marketplace, Cnr Cowpasture Rd & Kurrajong Rd",
    "addressLocality": "Carnes Hill",
    "addressRegion": "NSW",
    "postalCode": "2171",
    "addressCountry": "AU"
  },
  "areaServed": [
    { "@type": "Place", "name": "South West Sydney" },
    { "@type": "State", "name": "New South Wales" }
  ],
  "sameAs": [
    "https://www.facebook.com/DolceVita.Carneshill/",
    "https://www.instagram.com/dolcevita.carneshill/"
  ]
}
</script>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site-head">
  <div class="tricolore" aria-hidden="true"></div>
  <div class="wrap head-row">
    <a class="brand" href="/" aria-label="Pasticceria Dolce Vita, home">
      <img src="/images/logo-white.png" alt="Pasticceria Dolce Vita" width="620" height="167">
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu <span class="bars" aria-hidden="true"></span>
    </button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <a href="/" aria-current={current('home')}>Home</a>
      <a href="/about" aria-current={current('about')}>About us</a>
      <a href="/our-range" aria-current={current('our-range')}>Our range</a>
      <a href="/faq" aria-current={current('faq')}>FAQ</a>
      <a href="/contact" aria-current={current('contact')}>Contact us</a>
      <a class="btn btn-gold" href="/order" aria-current={current('order')}>Order a cake</a>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1">
<slot />
</main>

<footer class="site-foot">
  <div class="tricolore" aria-hidden="true"></div>
  <div class="wrap">
    <div class="foot-row">
      <a href="/" aria-label="Pasticceria Dolce Vita, home"><img src="/images/logo-white.png" alt="Pasticceria Dolce Vita" width="620" height="167" loading="lazy"></a>
      <nav class="foot-nav" aria-label="Footer">
        <a href="/about" aria-current={current('about')}>About us</a>
        <a href="/our-range" aria-current={current('our-range')}>Our range</a>
        <a href="/order" aria-current={current('order')}>Order a cake</a>
        <a href="/faq" aria-current={current('faq')}>FAQ</a>
        <a href="/contact" aria-current={current('contact')}>Contact us</a>
      </nav>
    </div>
    <div class="foot-base">
      <span>&copy; 2026 Pasticceria Dolce Vita. Italian cake shop, Carnes Hill NSW.</span>
    </div>
  </div>
</footer>

<script>
  /* ---------- Menu ---------- */
  const nav = document.getElementById('site-nav')!;
  const menuBtn = document.querySelector('.menu-btn')!;
  function setMenu(open: boolean) {
    nav.classList.toggle('open', open);
    menuBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  menuBtn.addEventListener('click', function () { setMenu(!nav.classList.contains('open')); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setMenu(false); });
</script>
</body>
</html>
